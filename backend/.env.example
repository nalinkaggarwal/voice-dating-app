# Copy to .env for local dev. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml's postgres service)
DATABASE_URL="postgresql://lolly:lolly_dev_password@localhost:5432/lolly?schema=public"

# Redis (matches docker-compose.yml's redis service)
REDIS_URL="redis://localhost:6379"

# JWT
# Access token: short-lived, re-issued on every refresh.
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_EXPIRES_IN="15m"
# Refresh token: rotating, revocable, stored hashed in RefreshToken.
JWT_REFRESH_SECRET="change-me-dev-only-different-from-access"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
# Pepper mixed into the OTP hash before storage (in addition to the
# per-challenge salt Prisma-less bcrypt/argon2 would add -- see
# identity/otp.service.ts for why a pepper is used here specifically).
OTP_PEPPER="change-me-dev-only"
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# S3-compatible storage (client wiring only for WP1 -- no upload flows yet)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lolly-dev"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_FORCE_PATH_STYLE=true

# SMS/email OTP delivery -- WP1 uses a console-logging stub provider
# (see identity/providers/). Fill these in when a real provider is wired.
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""
