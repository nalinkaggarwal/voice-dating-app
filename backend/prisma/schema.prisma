// Lolly.ai — WP1 schema.
// Core entities are exactly as specified in the WP1 kickoff brief.
// OtpChallenge and RefreshToken are additions needed to actually implement
// the brief's auth requirements (OTP-only, rotating refresh tokens) --
// the brief didn't spec their columns, so documented reasoning is inline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  email       String?    @unique
  phone       String?    @unique
  dateOfBirth DateTime
  status      UserStatus @default(ACCOUNT_CREATED)
  // WP3 addition: which daily-candidate-limit tier this user is on (see
  // DiscoveryConfig). No billing logic here -- billing/ is still a stub
  // and will presumably set this later; WP3 only needs to KNOW the tier,
  // not how someone became premium.
  tier        UserTier   @default(FREE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  consents      Consent[]
  profile       Profile?
  refreshTokens RefreshToken[]
  otpChallenges OtpChallenge[]
  voiceAnswers  VoiceAnswer[]
  preference    Preference?
  discoveryQueueEntries DiscoveryQueueEntry[]

  connectionsAsA Connection[] @relation("ConnectionUserA")
  connectionsAsB Connection[] @relation("ConnectionUserB")

  // Application-level invariant (Prisma has no portable CHECK constraint):
  // exactly one of email/phone is required at signup, enforced in
  // identity/dto and IdentityService, not here.
}

enum UserTier {
  FREE
  PREMIUM
}

enum UserStatus {
  ACCOUNT_CREATED
  BASIC_INFO_DONE
  PREFERENCES_DONE
  INTENT_DONE
  VOICE_RECORDED
  AI_REVIEW_DONE
  PHOTO_UPLOADED
  ACTIVE
}

model Consent {
  id        String   @id @default(uuid())
  userId    String
  type      String // e.g. "voice_processing", "data_processing"
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Profile {
  id          String  @id @default(uuid())
  userId      String  @unique
  displayName String?
  geohash     String? // coarse location only, never exact lat/long
  photoUrl    String?
  // WP3 addition: the user's OWN gender. Neither WP1 nor WP2 ever
  // captured this -- Preference.genderInterest only records who a user
  // is interested in, not what they themselves are, which is a
  // prerequisite for WP3's mutual gender-compatibility filter (checking
  // A's genderInterest against B's gender requires B to actually have
  // one on file). Nullable: a user who hasn't set this yet is simply
  // ineligible as a CANDIDATE for anyone (can't verify mutual
  // compatibility) until they do -- enforced in EligibilityService, not
  // by making this required at the DB level (basic-info submission in
  // WP2 didn't collect it, so backfilling as NOT NULL would break
  // existing rows).
  gender      Gender?
  user        User    @relation(fields: [userId], references: [id])

  claims ProfileClaim[]
}

enum Gender {
  MAN
  WOMAN
  NON_BINARY
}

model Connection {
  id              String           @id @default(uuid())
  userAId         String
  userBId         String
  status          ConnectionStatus @default(SUGGESTED)
  userAInterested Boolean          @default(false)
  userBInterested Boolean          @default(false)
  userASnapDone   Boolean          @default(false)
  userBSnapDone   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userA User @relation("ConnectionUserA", fields: [userAId], references: [id])
  userB User @relation("ConnectionUserB", fields: [userBId], references: [id])

  // One row per unordered pair -- ConnectionsService is responsible for
  // always calling with a canonical (lower-id-first) ordering so a pair
  // can never get two rows the two possible orderings.
  @@unique([userAId, userBId])
  @@index([userBId])
}

enum ConnectionStatus {
  SUGGESTED
  MUTUAL_INTEREST
  SNAP_PENDING
  AUTHENTICATED_MATCH
  ACTIVE
  BLOCKED
  CLOSED
}

// ── Auth support models (not in the brief's schema block) ──────────────

enum OtpChannel {
  EMAIL
  PHONE
}

enum OtpPurpose {
  SIGNUP
  LOGIN
}

model OtpChallenge {
  id         String     @id @default(uuid())
  // Nullable: a signup challenge is sent before a User row exists.
  userId     String?
  identifier String // the raw email or phone the code was sent to
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String // sha256(code + pepper) -- the raw code is never stored
  expiresAt  DateTime
  consumedAt DateTime?
  // Wrong-code attempts against this specific challenge; the service
  // layer invalidates the challenge once this crosses a small limit,
  // independent of any IP/account-level rate limiting done elsewhere.
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  // SIGNUP-purpose only: holds the not-yet-a-User signup input so the
  // client doesn't have to resend it on verify, and so the User row is
  // only ever created atomically alongside OTP verification succeeding.
  pendingDateOfBirth DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([identifier, channel, purpose])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  // sha256 of the raw refresh token -- the raw value is only ever seen by
  // the client, never persisted.
  tokenHash  String    @unique
  // All tokens descended from the same original login share a familyId.
  // Presenting an already-rotated (or already-revoked) token is treated
  // as evidence of theft: the whole family is revoked, not just that token.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  // id of the token that rotated this one out, for audit/debugging.
  replacedBy String?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

// ── WP2: voice-to-profile pipeline + preferences ────────────────────────

enum VoiceAnswerStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  EXTRACTING
  DRAFT_READY
  USER_APPROVED
  // Not in the brief's enum, but both stages genuinely can fail (a
  // mock/real provider can throw) and "silently stuck at TRANSCRIBING
  // forever" isn't a real status -- FAILED is a terminal state a retry
  // can be built against later, not swallowed into one of the enum
  // values above that would misreport what actually happened.
  FAILED
}

model VoiceAnswer {
  id     String @id @default(uuid())
  userId String

  // S3 object key (not a public URL -- audio is never publicly readable;
  // a signed GET URL is generated on demand from this key when needed).
  audioUrl   String
  transcript String?
  status     VoiceAnswerStatus @default(UPLOADED)

  // Set when a TRANSCRIBING/EXTRACTING job throws -- lets the API surface
  // *why* without leaking raw provider error text to the client.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  claims ProfileClaim[]

  @@index([userId])
}

model ProfileClaim {
  id            String  @id @default(uuid())
  profileId     String
  voiceAnswerId String // which recording this claim was extracted from
  text          String // the actual claim/fact, in the user's own words
  sourceSpan    String? // reference back to transcript position
  approved      Boolean @default(false)
  // false once the user discards it in the review screen -- kept as a
  // row (not deleted) so the extraction step's own output stays
  // inspectable/auditable against the guardrails, not lost on discard.
  discarded     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     Profile     @relation(fields: [profileId], references: [id])
  voiceAnswer VoiceAnswer @relation(fields: [voiceAnswerId], references: [id])

  @@index([profileId])
  @@index([voiceAnswerId])
}

model Preference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  genderInterest     String[]
  ageMin             Int?
  ageMax             Int?
  maxDistanceKm      Int?
  relationshipIntent String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ── WP3: daily discovery queue ──────────────────────────────────────────

// DB-backed (not env/code) so free vs. premium daily limits can be
// changed independently without a deploy -- the queue-generation job
// reads this fresh on every run, so an ops UPDATE takes effect on the
// next scheduled run automatically. Seeded with both tiers at 1/day
// (WP3's actual scope is exactly one candidate/day for everyone), but
// premium can be raised later purely by editing this row.
model DiscoveryConfig {
  id                  String   @id @default(uuid())
  tier                UserTier @unique
  dailyCandidateLimit Int      @default(1)
  updatedAt           DateTime @updatedAt
}

model DiscoveryQueueEntry {
  id          String   @id @default(uuid())
  userId      String
  candidateId String
  reasonText  String // short, plain-language, non-scored explanation
  queueDate   DateTime // the day this was generated for (date-only, time zeroed)
  // 0-indexed rank within this user's batch for queueDate. Almost always
  // 0 (one candidate/day) -- exists so a premium tier with
  // dailyCandidateLimit > 1 doesn't need a schema change later; the
  // brief's own suggested @@unique([userId, queueDate]) would make that
  // impossible; @@unique([userId, queueDate, sequenceInDay]) preserves
  // the same "can't double-generate" guarantee per slot instead.
  sequenceInDay Int      @default(0)
  shown       Boolean  @default(false)
  decidedAt   DateTime?
  decision    DecisionType?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, queueDate, sequenceInDay])
  @@index([candidateId])
}

enum DecisionType {
  PASS
  INTERESTED
}
